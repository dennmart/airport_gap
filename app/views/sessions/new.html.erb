<% content_for :title, "Log In | Airport Gap" %>
<% content_for :robots, "noindex" %>

<div class="account">
  <%= render "shared/masthead" %>

  <div class="account-inner">
    <div class="account-panel">
      <div class="account-intro">
        <p>
          Log in to your Airport Gap account to access and/or regenerate your authentication token.
        </p>

        <p>
          If you haven't generated an authentication token yet, you can
          <%= link_to "get your token here", tokens_path %>.
        </p>
      </div>

      <div class="account-form">
        <%= render "shared/flash" %>

        <h1>Log in to your Airport Gap account</h1>

        <%= form_for User.new, url: "/login" do |f| %>
          <div class="field">
            <%= f.label :email, "Email Address" %>
            <%= f.email_field :email, autocomplete: "email" %>
          </div>

          <div class="field">
            <%= f.label :password, "Password" %>
            <%= f.password_field :password, autocomplete: "current-password" %>
          </div>

          <%= f.submit "Log In", class: "button button-primary" %>
        <% end %>
      </div>
    </div>

    <p class="account-alt-link">
      <%= link_to "Forgot your password?", new_password_reset_path %>
    </p>
  </div>
</div>
