<% content_for :title, "Change Your Password | Airport Gap" %>
<% content_for :robots, "noindex" %>

<div class="account">
  <%= render "shared/masthead" %>

  <div class="account-inner account-narrow">
    <%= render "shared/flash" %>
    <%= render "shared/form_errors", record: current_user, title: "There were some problems updating your password:" %>

    <div class="account-card">
      <h1>Change your password</h1>

      <%= form_for current_user, url: change_password_path do |f| %>
        <div class="field">
          <%= label_tag :current_password, "Current Password" %>
          <%= password_field_tag :current_password, "", autocomplete: "current-password" %>
        </div>

        <div class="field">
          <%= f.label :password, "New Password" %>
          <%= f.password_field :password, autocomplete: "new-password" %>
        </div>

        <div class="field">
          <%= f.label :password_confirmation, "Confirm New Password" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
        </div>

        <%= f.submit "Change Password", class: "button button-primary" %>
      <% end %>
    </div>
  </div>
</div>
