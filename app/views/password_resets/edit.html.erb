<div class="account">
  <%= render "shared/masthead" %>

  <div class="account-inner">
    <div class="account-panel">
      <div class="account-intro">
        <p>
          Set up a new password for your Airport Gap account.
        </p>
      </div>

      <div class="account-form">
        <%= render "shared/form_errors", record: @user, title: "There were some problems resetting your password:" %>

        <h1>Set up a new password</h1>

        <%= form_for @user, url: password_reset_path(password_reset_token: params[:password_reset_token]) do |f| %>
          <div class="field">
            <%= f.label :password, "Password" %>
            <%= f.password_field :password, autocomplete: "new-password" %>
          </div>

          <div class="field">
            <%= f.label :password_confirmation, "Confirm your password" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
          </div>

          <%= f.submit "Reset Your Password", class: "button button-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
