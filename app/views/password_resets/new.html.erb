<% content_for :head do %>
  <%= render "shared/fonts" %>
<% end %>

<div class="account">
  <%= render "shared/masthead" %>

  <div class="account-inner">
    <div class="account-panel">
      <div class="account-intro">
        <p>
          If you forgot your Airport Gap password, enter your email address to receive instructions
          to reset your password.
        </p>
      </div>

      <div class="account-form">
        <%= render "shared/flash" %>

        <h1>Forgot your Airport Gap password?</h1>

        <%= form_tag password_reset_path do %>
          <div class="field">
            <%= label_tag :email, "Email Address" %>
            <%= email_field_tag :email, "", autocomplete: "email" %>
          </div>

          <%= submit_tag "Send Reset Instructions", class: "button button-primary" %>
        <% end %>
      </div>
    </div>

    <p class="account-alt-link">
      <%= link_to "Log in to your Airport Gap account", login_path %>
    </p>
  </div>
</div>
