<% content_for :title, "Your Account | Airport Gap" %>
<% content_for :robots, "noindex" %>

<div class="account">
  <%= render "shared/masthead" %>

  <div class="account-inner account-narrow">
    <%= render "shared/flash" %>

    <div class="account-card">
      <h1>Your Account Information</h1>

      <p id="user_email_address" class="account-detail">
        <strong>Email Address:</strong> <%= current_user.email %>
      </p>

      <p id="user_auth_token" class="account-detail account-token">
        <strong>Authentication Token: </strong>
        <span class="account-token-box">
          <code id="auth_token_value"><%= current_user.token %></code>
          <button type="button" class="copy-button" aria-label="Copy authentication token" hidden
                  data-copy="#auth_token_value" data-copy-status="#auth_token_status">
            <svg class="copy-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="8" y="8" width="12" height="13" rx="2" />
              <path d="M16 8V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h2" />
            </svg>
            <svg class="copied-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12.5l4.5 4.5L19 7" />
            </svg>
          </button>
        </span>
      </p>
      <p id="auth_token_status" class="copy-status" role="status"></p>

      <div class="account-actions">
        <%= button_to "Regenerate Authentication Token", regenerate_tokens_path, class: "button button-secondary" %>
      </div>

      <ul class="account-links">
        <li><%= link_to "Change Password", change_password_path %></li>
        <li><%= link_to "API Documentation", docs_path %></li>
        <li><%= link_to "Sign Out", logout_path, method: :delete %></li>
      </ul>
    </div>
  </div>
</div>
