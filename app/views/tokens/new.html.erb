<% content_for :title, "Generate a Free API Token | Airport Gap" %>
<% content_for :description, "Create a free Airport Gap account and get an API token to test authenticated REST endpoints, like saving favorite airports." %>

<% content_for :head do %>
  <%= javascript_include_tag "https://challenges.cloudflare.com/turnstile/v0/api.js", async: true, defer: true, "data-turbo-track": "reload" %>
<% end %>

<div class="account">
  <%= render "shared/masthead" %>

  <div class="account-inner">
    <div class="account-panel">
      <div class="account-intro">
        <p>
          To access API endpoints that require authentication, you need an authentication
          token. Read the <%= link_to "API documentation", docs_path %> for more information.
        </p>

        <p>
          Your email address is only used to generate your authentication token and to access
          it when needed. You will never receive any unsolicited emails from this service
          or Dev Tester.
        </p>
      </div>

      <div class="account-form">
        <%= render "shared/flash" %>
        <%= render "shared/form_errors", record: @user, title: "There were some problems generating your token:" %>

        <h1>Generate an authentication token</h1>

        <%= form_for @user, url: tokens_path, data: { turbo: false } do |f| %>
          <div class="field">
            <%= f.label :email, "Email Address" %>
            <%= f.email_field :email, autocomplete: "email" %>
          </div>

          <div class="field">
            <%= f.label :password, "Password" %>
            <%= f.password_field :password, autocomplete: "new-password" %>
          </div>

          <div class="captcha">
            <%= captcha %>
          </div>

          <%= f.submit "Generate Token", class: "button button-primary" %>
        <% end %>
      </div>
    </div>

    <p class="account-alt-link">
      <%= link_to "Already generated an authentication token?", login_path %>
    </p>
  </div>
</div>
