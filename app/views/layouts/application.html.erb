<!DOCTYPE html>
<html lang="en">
  <head>
    <% page_title = content_for(:title).presence || "Airport Gap - A free REST API for practicing API test automation" %>
    <% page_description = content_for(:description).presence || "Practice API test automation against a real REST API with token authentication, rate limits and failures you can trigger on demand. Free to use." %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Search Engine -->
    <meta name="description" content="<%= page_description %>">
    <% if content_for?(:robots) %>
      <meta name="robots" content="<%= yield :robots %>">
    <% end %>
    <meta name="image" content="<%= request.base_url %>/images/airport_gap_logo.png">

    <!-- Schema.org for Google -->
    <meta itemprop="name" content="<%= page_title %>">
    <meta itemprop="description" content="<%= page_description %>">
    <meta itemprop="image" content="<%= request.base_url %>/images/airport_gap_logo.png">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= request.base_url %>/images/airport_gap_share_logo.png">

    <!-- Open Graph -->
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= request.base_url + request.path %>">
    <meta property="og:site_name" content="Airport Gap">
    <meta property="og:type" content="website">
    <meta property="og:image" content="<%= request.base_url %>/images/airport_gap_share_logo.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;600&family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,600;0,800;1,400&display=swap" rel="stylesheet">

    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= yield :head %>
  </head>

  <body>
    <main role="main">
      <%= yield %>
    </main>
  </body>

  <% if Rails.env.production? && ENV['APPLICATION_HOST'] == "airportgap.com" %>
    <!-- Fathom - simple website analytics - https://usefathom.com -->
    <script>
      (function(f, a, t, h, o, m){
      a[h]=a[h]||function(){
      (a[h].q=a[h].q||[]).push(arguments)
      };
      o=f.createElement('script'),
      m=f.getElementsByTagName('script')[0];
      o.async=1; o.src=t; o.id='fathom-script';
      m.parentNode.insertBefore(o,m)
      })(document, window, 'https://cdn.usefathom.com/tracker.js', 'fathom');
      fathom('set', 'siteId', '<%= Rails.application.credentials.fathom[:site_id] %>');
      fathom('trackPageview');
    </script>
    <!-- / Fathom -->
  <% end %>
</html>
