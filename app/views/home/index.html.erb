<% content_for :title, "API Testing Practice with a Free REST API | Airport Gap" %>
<% content_for :description, "Practice API testing against a free REST API with token authentication, rate limits and failures you can trigger on demand. Free to use." %>

<div class="home">
  <%= render "shared/masthead" %>

  <section class="sign" aria-labelledby="sign-title">
    <div class="sign-inner">
      <div class="sign-body">
        <div class="sign-intro">
          <h1 id="sign-title">Practice API testing and automation against a real REST API.</h1>

          <p class="sign-lede">
            Airport Gap is a free REST API made for API testing practice and test automation. It has real endpoints, real
            authentication and failures you can trigger on purpose, so your tests run against more than a happy path.
          </p>

          <div class="sign-actions">
            <%= link_to "Generate a token", tokens_path, class: "button button-primary" %>
            <%= link_to "Read the API docs", docs_path, class: "button button-secondary" %>
          </div>

          <p class="sign-note">Free. Just an email and password, and we'll never send you marketing email.</p>
        </div>

        <div class="example" data-example-tabs>
          <div class="example-tabs" role="tablist" aria-label="Example request" hidden>
            <button type="button" role="tab" id="example-tab-success" aria-controls="example-success"
                    aria-selected="true">Success</button>
            <button type="button" role="tab" id="example-tab-failure" aria-controls="example-failure"
                    aria-selected="false" tabindex="-1">Simulated failure</button>
          </div>

          <div class="example-panels">
            <div class="example-panel" id="example-success" role="tabpanel" aria-labelledby="example-tab-success">
              <h2 class="example-heading">Save a favorite airport</h2>
              <pre class="example-code"><code><%= http_example(<<~HTTP)
                POST /api/favorites HTTP/1.1
                Host: airportgap.com
                Authorization: Bearer token=<your token>
                Content-Type: application/json

                {
                  "airport_id": "JFK",
                  "note": "My usual layover"
                }
              HTTP
              %></code></pre>

              <h2 class="example-heading">
                Response
                <span class="example-status example-status-success">201 Created</span>
              </h2>
              <pre class="example-code"><code><%= http_example(<<~HTTP)
                Content-Type: application/json

                {
                  "data": {
                    "id": "11",
                    "type": "favorite",
                    "attributes": {
                      "airport": {
                        "iata": "JFK",
                        "name": "John F Kennedy International Airport",
                        "city": "New York",
                        "country": "United States"
                      },
                      "note": "My usual layover"
                    }
                  }
                }
              HTTP
              %></code></pre>
            </div>

            <div class="example-panel" id="example-failure" role="tabpanel" aria-labelledby="example-tab-failure">
              <h2 class="example-heading">The same request, failing on purpose</h2>
              <pre class="example-code"><code><%= http_example(<<~HTTP, highlight: "X-Simulate:")
                POST /api/favorites HTTP/1.1
                Host: airportgap.com
                Authorization: Bearer token=<your token>
                Content-Type: application/json
                X-Simulate: service-unavailable

                {
                  "airport_id": "JFK",
                  "note": "My usual layover"
                }
              HTTP
              %></code></pre>

              <h2 class="example-heading">
                Response
                <span class="example-status example-status-failure">503 Service Unavailable</span>
              </h2>
              <pre class="example-code"><code><%= http_example(<<~HTTP)
                Content-Type: application/json
                Retry-After: 30

                {
                  "errors": [
                    {
                      "status": "503",
                      "title": "Service Unavailable",
                      "detail": "The service is simulating downtime. Retry your request after 30 seconds."
                    }
                  ]
                }
              HTTP
              %></code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="home-content">
    <section class="practice" aria-labelledby="practice-title">
      <h2 id="practice-title">What you can practice in your API tests</h2>

      <dl class="practice-list">
        <dt>Every main HTTP method</dt>
        <dd>Send GET, POST, PATCH and DELETE requests across airports and favorites, so your suite covers both reads and writes.</dd>

        <dt>Token authentication</dt>
        <dd>
          <%= link_to "Generate a token", tokens_path %> and send it in the
          <%= link_to docs_path(anchor: "authentication") do %><code>Authorization</code> header<% end %> to call the favorites
          endpoints.
        </dd>

        <dt>Data that persists</dt>
        <dd>Favorites stay saved in your account, so you can test create, update and delete flows end to end.</dd>

        <dt>Failures on demand</dt>
        <dd>
          Add the <code>X-Simulate</code> header to get server errors, downtime, slow responses, malformed JSON or
          wrong content types, so you can check how your tests handle retries, timeouts and bad responses.
          <%= link_to "See failure simulation", docs_path(anchor: "failure_simulation") %>.
        </dd>

        <dt>Rate limits</dt>
        <dd>
          Each IP address can send up to 100 requests a minute, so you can check how your tests handle a 429 response.
          Slow simulations are limited to 10 a minute. <%= link_to "See rate limiting", docs_path(anchor: "rate_limiting") %>.
        </dd>
      </dl>
    </section>

    <section class="directory" aria-labelledby="directory-title">
      <h2 id="directory-title">REST API endpoints to test</h2>

      <table class="directory-table">
        <thead>
          <tr>
            <th scope="col">Method</th>
            <th scope="col">Path</th>
            <th scope="col">What it does</th>
          </tr>
        </thead>
        <tbody>
          <% [
               ["GET", "/airports", "List all airports, one page at a time", "api_ref_get_airports", false],
               ["GET", "/airports/:id", "Get one airport by its IATA code", "api_ref_get_airports_id", false],
               ["POST", "/airports/distance", "Measure the distance between two airports", "api_ref_post_airports_distance", false],
               ["POST", "/tokens", "Get your token with your email and password", "api_ref_post_tokens", false],
               ["GET", "/favorites", "List your saved airports", "api_ref_get_favorites", true],
               ["GET", "/favorites/:id", "Get one saved airport", "api_ref_get_favorites_id", true],
               ["POST", "/favorites", "Save a favorite airport", "api_ref_post_favorites", true],
               ["PATCH", "/favorites/:id", "Update the note on a saved airport", "api_ref_patch_favorites", true],
               ["DELETE", "/favorites/:id", "Remove a saved airport", "api_ref_delete_favorites", true],
               ["DELETE", "/favorites/clear_all", "Remove all saved airports", "api_ref_clear_all_favorites", true]
             ].each do |verb, path, summary, anchor, token_required| %>
            <tr>
              <td><span class="verb verb-<%= verb.downcase %>"><%= verb %></span></td>
              <td><%= link_to path, docs_path(anchor: anchor), class: "directory-path" %></td>
              <td>
                <%= summary %>
                <% if token_required %><span class="directory-token">Needs a token</span><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  </div>

  <section class="next-step" aria-labelledby="next-step-title">
    <div class="next-step-inner">
      <%= link_to "https://testnod.com/", class: "next-step-logo", target: "_blank", rel: "noopener" do %>
        <%= image_tag "testnod_logo.png", alt: "TestNod", width: 1503, height: 352 %>
      <% end %>

      <div class="next-step-body">
        <h2 id="next-step-title">When your tests run in CI</h2>
        <p>
          On Airport Gap, you choose when things fail. In CI, failures show up on their own, and the hard part is
          telling a real regression from a flaky test.
        </p>
        <p>
          TestNod reads the JUnit XML reports your CI already produces and tracks pass rates, flaky tests and slowdowns
          across every build. It's from the maker of Airport Gap and free while in beta.
        </p>
        <%= link_to "See how TestNod works →", "https://testnod.com/", class: "next-step-link", target: "_blank", rel: "noopener" %>
      </div>
    </div>
  </section>

  <footer class="home-footer">
    <div class="home-footer-inner">
      <p>
        Airport data comes from <a href="https://openflights.org/data.php">OpenFlights.org</a> under the
        <a href="http://opendatacommons.org/licenses/odbl/1.0/">Open Database License</a>.
      </p>
      <p>
        Airport Gap is made by <a href="https://dev-tester.com/">Dev Tester</a>, with articles and tips on test
        automation for developers. The <a href="https://github.com/dennmart/airport_gap">source code</a> is on GitHub.
      </p>
    </div>
  </footer>
</div>
